<?xml version="1.0" encoding="UTF-8"?>
<beast version='2.0'
namespace='beast.core:beast.evolution.tree.coalescent:beast.core.util:beast.evolution.nuc:beast.evolution.operators:beast.evolution.sitemodel:beast.evolution.substitutionmodel:beast.evolution.likelihood'>

    <data dataType="nucleotide" id="alignment">
        <sequence taxon="MSB259148"></sequence>
        <sequence taxon="MSB261737"></sequence>
        <sequence taxon="MSB269732"></sequence>
        <sequence taxon="MSB269776"></sequence>
        <sequence taxon="MSB269806"></sequence>
        <sequence taxon="MSB281100"></sequence>
        <sequence taxon="MSB311857"></sequence>
        <sequence taxon="MSB43525"></sequence>
        <sequence taxon="MSB83485"></sequence>
        <sequence taxon="MVZ217504"></sequence>
        <sequence taxon="MVZ223025"></sequence>
        <sequence taxon="MVZ223028"></sequence>
        <sequence taxon="UAM101701"></sequence>
        <sequence taxon="UAM41739"></sequence>
        <sequence taxon="UAM93314"></sequence>
        <sequence taxon="MVZ240272"></sequence>
        <sequence taxon="MVZ240328"></sequence>
        <sequence taxon="MVZ240329"></sequence>
        <sequence taxon="MVZ240330"></sequence>
    </data>

    <tree spec='beast.util.ClusterTree' id='tree' clusterType='upgma'>
        <taxa idref='alignment'/>
    </tree>

    <distribution spec="CompoundDistribution" id="posterior">
        <distribution spec="CompoundDistribution" id="prior">
            <distribution spec="BayesianSkyline" id='skyline'>
                <popSizes idref="skyline.popSize"/>
                <groupSizes idref='skyline.groupSize'/>
                <treeIntervals spec='TreeIntervals' id='TreeIntervals'>
                    <tree idref="tree"/>
                </treeIntervals>
            </distribution>
            <distribution id='eml1' spec="beast.math.distributions.MarkovChainDistribution" jeffreys="true" parameter="@skyline.popSize"/>
        </distribution>

        <distribution spec='TreeLikelihood' id="likelihood">
            <data idref="alignment"/>
            <tree idref="tree"/>
            <siteModel spec='SiteModel' id="siteModel" gammaCategoryCount="1">
                <substModel spec='HKY' id="hky">
                    <parameter name='kappa' id="hky.kappa" value="2.0" lower="0.0" estimate="false"/>
                    <frequencies id='freqs' spec='Frequencies' data="@alignment"/>
                </substModel>
            </siteModel>
            <branchRateModel spec='beast.evolution.branchratemodel.StrictClockModel' id="branchRates">
                <parameter name='clock.rate' id='clock.rate' value="1.0" lower="0.0" estimate="false"/>
            </branchRateModel>
        </distribution>
    </distribution>

    <run spec="MCMC" id="mcmc" chainLength="3200000">
        <state>
            <parameter name='stateNode' id="skyline.popSize" dimension="5" value="10000.0 10000.0 10000.0 10000.0 10000.0" lower="0.0"/>
            <stateNode spec='parameter.IntegerParameter' id='skyline.groupSize' dimension="5" value="1 1 1 1 1"/>
            <stateNode idref="tree"/>
        </state>

        <distribution idref="posterior"/>
        <operator id='popSizesScaler' spec='ScaleOperator' scaleFactor="0.75" weight="10" parameter="@skyline.popSize"/>
        <operator id='groupSizesDelta' spec='DeltaExchangeOperator' delta="1" weight="4" integer="true" intparameter="@skyline.groupSize"/>
        <operator id='treeRootScaler' spec='ScaleOperator' scaleFactor="0.75" weight="3" tree="@tree" rootOnly='true'/>
        <operator spec='Uniform' weight="20" tree="@tree"/>
        <operator spec='SubtreeSlide' weight="10" gaussian="true" size="2.0" tree="@tree"/>
        <operator id='narrow' spec='Exchange' isNarrow='true' weight="10" tree="@tree"/>
        <operator id='wide' spec='Exchange' isNarrow='false' weight="2" tree="@tree"/>
        <operator spec='WilsonBalding' weight="2" tree="@tree"/>

        <logger logEvery="500" fileName="/Users/gspellman/Trowbridgii_analyses/Stacks analysis of ddRAD data/stacks_refmap_sorex_excl_MVZ216210_2026-02-26_clean/downstream_analysis_2026-02-23/beast_skyline/North/North_bsp.log">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="skyline"/>
            <log idref="skyline.popSize"/>
            <log idref="skyline.groupSize"/>
            <log spec='beast.evolution.tree.TreeHeightLogger' tree='@tree' id='treeModel.rootHeight'/>
        </logger>
        <logger logEvery="500" fileName="/Users/gspellman/Trowbridgii_analyses/Stacks analysis of ddRAD data/stacks_refmap_sorex_excl_MVZ216210_2026-02-26_clean/downstream_analysis_2026-02-23/beast_skyline/North/North_bsp.trees"><log idref="tree"/></logger>
        <logger logEvery="10000"><log idref="posterior"/><log idref="likelihood"/></logger>
    </run>
</beast>
